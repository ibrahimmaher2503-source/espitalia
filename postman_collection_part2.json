    {
      "name": "Save Clinic",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My Clinic\",\n  \"email\": \"clinic@example.com\",\n  \"mobile\": \"+201234567890\",\n  \"address\": \"123 Medical Street\",\n  \"governorate_id\": 1,\n  \"city_id\": 1,\n  \"status\": 1\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{base_url}}/save-clinic", "host": ["{{base_url}}"], "path": ["save-clinic"]},
        "description": "Create a new clinic"
      }
    },
