      "request": {
        "auth": {"type": "noauth"},
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/get-clinic-gallery?clinic_id=1",
          "host": ["{{base_url}}"],
          "path": ["get-clinic-gallery"],
          "query": [{"key": "clinic_id", "value": "1"}]
        },
        "description": "Get clinic gallery images (public)"
      }
    },
    {
      "name": "Get Time Slots (Public)",
      "request": {
        "auth": {"type": "noauth"},
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/get-time-slots?doctor_id=1&date=2026-04-20&clinic_id=1",
          "host": ["{{base_url}}"],
          "path": ["get-time-slots"],
          "query": [
            {"key": "doctor_id", "value": "1"},
            {"key": "date", "value": "2026-04-20"},
            {"key": "clinic_id", "value": "1"}
          ]
        },
        "description": "Get available time slots for booking (public)"
      }
    },
    {
      "name": "Search Doctors by Location",
      "request": {
        "auth": {"type": "noauth"},
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/doctors/search?governorate_id=1&city_id=1&specialization_id=1",
          "host": ["{{base_url}}"],
          "path": ["doctors", "search"],
          "query": [
            {"key": "governorate_id", "value": "1"},
            {"key": "city_id", "value": "1"},
            {"key": "specialization_id", "value": "1", "disabled": true}
          ]
        },
        "description": "Search doctors by location (public)"
      }
    },
    {
      "name": "Search Clinics by Location",
      "request": {
