          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{base_url}}/update-clinic/1", "host": ["{{base_url}}"], "path": ["update-clinic", "1"]},
        "description": "Update an existing clinic"
      }
    },
